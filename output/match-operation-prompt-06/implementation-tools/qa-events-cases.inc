 const a=await prepare(aId,'IFAB_2026_27',11),mp=new Pool({connectionString:db(qa('match'))}),dp=new Pool({connectionString:db(qa('discipline'))});
 try{
 await ok(btc,`/tournaments/${tourId}`,'PUT',{status:'IN_PROGRESS'});await time(Date.parse(a.context.schedule.scheduledDate)+1000);
 const clockUrl=`/matches/${aId}/clock-actions`,read=async()=>(await ok(ref,`/matches/${aId}/clock`)).clock,clockAction=async(action)=>(await ok(ref,clockUrl,'POST',{action,expectedVersion:(await read()).version})).clock;
 const team=a.m.homeTeamId,p=a.entries[0],starter=p[1].playerId,bench=p[11].playerId;
 const make=async(type,player=starter,extra={})=>{const c=await read();return {matchId:aId,teamId:team,playerId:player,eventType:type,operationId:randomUUID(),phase:c.phase,expectedClockVersion:c.version,...extra};};
 const write=async(type,player=starter,extra={})=>(await ok(ref,'/match-events','POST',await make(type,player,extra),201)).event;
 const events=async()=>(await ok(ref,`/matches/${aId}/referee-context`)).events;
 const drain=async()=>{const id=++requestId;return new Promise((resolve,reject)=>{const on=m=>{if(m.id!==id)return;child.off('message',on);m.error?reject(Error(m.error)):resolve(m.count);};child.on('message',on);child.send({op:'outbox',id});});};
 await clockAction('START_MATCH');await advance(10000);
 await check('bench cannot score; outside actor and organizer cannot record events or cards',async()=>{await rejected(ref,'/match-events','POST',await make('GOAL',bench),'EVENT_CHAIN_INVALID');for(const cookie of [outside,btc]){await rejected(cookie,'/match-events','POST',await make('GOAL'),null,403);await rejected(cookie,'/cards','POST',{matchId:aId,tournamentId:tourId,teamId:team,playerId:starter,cardType:'YELLOW'},null,403);}});
 let goal,own,penalty;
 await check('normal, own and in-play penalty goals update live score from canonical events',async()=>{goal=await write('GOAL');own=await write('OWN_GOAL',p[2].playerId);penalty=await write('PENALTY_GOAL',p[3].playerId);const e=await events();assert.equal(e.filter(x=>['GOAL','PENALTY_GOAL','OWN_GOAL'].includes(x.eventType)).length,3);});
 await check('concurrent retry with one operation ID records once; different same-minute events remain distinct',async()=>{const input=await make('GOAL');const responses=await Promise.all([ok(ref,'/match-events','POST',input,201),ok(ref,'/match-events','POST',input,201)]);assert.equal(responses[0].event.id,responses[1].event.id);await rejected(ref,'/match-events','POST',{...input,description:'Different request'},'EVENT_IDEMPOTENCY_CONFLICT');const distinct=await write('GOAL');assert.notEqual(distinct.id,responses[0].event.id);});
 await check('injected failure of IN insert rolls back OUT, audit and SSE atomically',async()=>{const old=(await events()).length;await mp.query(`CREATE FUNCTION qa_fail_substitution() RETURNS trigger AS $$ BEGIN IF NEW.event_type='SUBSTITUTION_IN' THEN RAISE EXCEPTION 'Controlled QA second-insert failure'; END IF; RETURN NEW; END; $$ LANGUAGE plpgsql; CREATE TRIGGER qa_fail_substitution BEFORE INSERT ON match_events FOR EACH ROW EXECUTE FUNCTION qa_fail_substitution()`);try{const response=await http(ref,'/match-events','POST',await make('SUBSTITUTION_OUT',starter,{relatedPlayerId:bench}));assert.equal(response.status,500);assert.equal((await events()).length,old);}finally{await mp.query('DROP TRIGGER qa_fail_substitution ON match_events; DROP FUNCTION qa_fail_substitution()');}});
 let sub,newGoal;
 await check('one request persists linked OUT and IN; substituted player cannot score or re-enter',async()=>{sub=await write('SUBSTITUTION_OUT',starter,{relatedPlayerId:bench});const pair=(await events()).filter(e=>e.substitutionId===sub.substitutionId);assert.equal(pair.length,2);assert.deepEqual(pair.map(x=>x.eventType),['SUBSTITUTION_OUT','SUBSTITUTION_IN']);await advance(1000);newGoal=await write('GOAL',bench);await rejected(ref,'/match-events','POST',await make('GOAL',starter),'EVENT_CHAIN_INVALID');await rejected(ref,'/match-events','POST',await make('SUBSTITUTION_OUT',bench,{relatedPlayerId:starter}),'EVENT_CHAIN_INVALID');});
 await check('void substitution rejects invalid downstream chain; after goal void the whole pair voids together',async()=>{await rejected(ref,`/match-events/${sub.id}`,'DELETE',{reason:'QA correction of a substitution'},'EVENT_CHAIN_INVALID');await ok(ref,`/match-events/${newGoal.id}`,'DELETE',{reason:'QA correction of the later goal',expectedRevision:1},204);await ok(ref,`/match-events/${sub.id}`,'DELETE',{reason:'QA correction of the substitution',expectedRevision:1},204);assert(!(await events()).some(x=>x.substitutionId===sub.substitutionId));await ok(ref,`/match-events/${sub.id}`,'DELETE',{reason:'Retry same correction'},204);});
 let yellow,second,red;
 await check('yellow, second yellow and direct red are distinct; dismissed players cannot score',async()=>{yellow=await write('YELLOW_CARD',p[4].playerId);await rejected(ref,'/match-events','POST',await make('YELLOW_CARD',p[4].playerId),'EVENT_CHAIN_INVALID');second=await write('SECOND_YELLOW_CARD',p[4].playerId);red=await write('RED_CARD',p[5].playerId);await rejected(ref,'/match-events','POST',await make('GOAL',p[4].playerId),'EVENT_CHAIN_INVALID');await rejected(ref,'/match-events','POST',await make('SUBSTITUTION_OUT',p[5].playerId,{relatedPlayerId:bench}),'EVENT_CHAIN_INVALID');await rejected(ref,`/match-events/${yellow.id}`,'DELETE',{reason:'Cannot remove the first yellow while second remains'},'EVENT_CHAIN_INVALID');});
 await check('legacy POST cards uses canonical event and outbox, no second direct card writer',async()=>{const cardInput={matchId:aId,tournamentId:tourId,teamId:team,playerId:p[6].playerId,cardType:'YELLOW',operationId:randomUUID()};const r=await ok(ref,'/cards','POST',cardInput,201);assert.equal(r.event.eventType,'YELLOW_CARD');await drain();const cards=(await dp.query('SELECT * FROM cards WHERE source_event_id IS NOT NULL')).rows;assert(cards.some(c=>c.source_event_id===r.event.id));});
 await check('outbox retry is idempotent for cards and suspensions; card void retracts source and dependent ban',async()=>{await drain();const before=(await dp.query('SELECT id FROM cards WHERE source_event_id=$1',[red.id])).rows;assert.equal(before.length,1);await mp.query("UPDATE match_event_discipline_outbox SET processed_at=NULL,available_at=NOW(),claimed_until=NULL WHERE event_id=$1",[red.id]);await drain();assert.equal((await dp.query('SELECT id FROM cards WHERE source_event_id=$1',[red.id])).rowCount,1);assert((await dp.query('SELECT id FROM suspensions WHERE source_card_id=$1',[before[0].id])).rowCount<=1);await ok(ref,`/match-events/${red.id}`,'DELETE',{reason:'QA correction of direct red card'},204);await drain();assert((await dp.query('SELECT voided_at FROM cards WHERE id=$1',[before[0].id])).rows[0].voided_at);assert.equal((await dp.query('SELECT id FROM suspensions WHERE source_card_id=$1 AND is_active',[before[0].id])).rowCount,0);});
 await check('crew-only incident is present internally and absent from public timeline',async()=>{const incident=await write('INCIDENT',undefined,{playerId:undefined,visibility:'CREW',description:'QA security incident in the technical area'});assert((await events()).some(x=>x.id===incident.id));assert(!(await ok(null,`/matches/${aId}/events`)).events.some(x=>x.id===incident.id));});
 await check('paused continuous clock permits cards but blocks goals; events retain phase and player',async()=>{await ok(ref,clockUrl,'POST',{action:'SUSPEND_PLAY',expectedVersion:(await read()).version,reason:'Controlled QA temporary safety suspension'});const card=await write('YELLOW_CARD',p[7].playerId);assert.equal(card.phase,'FIRST_HALF');await rejected(ref,'/match-events','POST',await make('GOAL'),'MATCH_CLOCK_NOT_RUNNING');await clockAction('RESUME');});
 await check('halftime allows cards and atomic substitutions without inventing playing time',async()=>{await advance(45*60000);await clockAction('END_PERIOD');assert.equal((await read()).phase,'HALF_TIME');const card=await write('YELLOW_CARD',p[8].playerId);assert.equal(card.phase,'HALF_TIME');const pair=await write('SUBSTITUTION_OUT',p[9].playerId,{relatedPlayerId:p[12].playerId});assert.equal(pair.phase,'HALF_TIME');});
 await check('event history is append-only and reload restores IDs, links and effective events',async()=>{await assert.rejects(mp.query('UPDATE match_event_history SET reason=reason WHERE match_id=$1',[aId]),/append-only/);const old=await events();await stopChild();await startChild();assert.deepEqual((await events()).map(x=>x.id),old.map(x=>x.id));});
 await check('official five business databases remain unchanged',async()=>assert.deepEqual(await officialSnapshot(),before));
 }finally{await mp.end();await dp.end();}
