PORT=3001
NODE_ENV=development

# PostgreSQL (credentials / users — MVP schema sẽ bổ sung sau)
DATABASE_URL=postgresql://sfl:sfl_dev_password@localhost:5432/sfl_auth

# Redis — lưu session (sid -> userId, metadata)
REDIS_URL=redis://localhost:6379/0

# Session cookie (HttpOnly do auth-service/gateway set)
SESSION_COOKIE_NAME=sfl_sid
SESSION_TTL_SECONDS=86400
SESSION_SECRET=change-me-in-production-use-long-random-string

# URL nội bộ
# Local dev: localhost; Docker Compose: http://user-service:3002
USER_SERVICE_URL=http://localhost:3002
# Khớp INTERNAL_API_KEY của user-service (nếu bật)
USER_SERVICE_INTERNAL_API_KEY=

# SMTP provider for real verification emails (required for registration)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SFL Development <no-reply@sfl.local>
CLIENT_URL=http://localhost:5173
