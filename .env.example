# Copy to .env and replace development-only values before deploying.
NODE_ENV=development
COMPOSE_PROFILES=apps

POSTGRES_USER=sfl
POSTGRES_PASSWORD=sfl_dev_password
POSTGRES_DB=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379

CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SESSION_SECRET=replace-with-at-least-32-random-bytes
INTERNAL_API_KEY=replace-with-a-long-random-secret
SEED_DEMO_USERS=false

# Real SMTP is used in every environment. Supply credentials for a verified sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Sân Cỏ
